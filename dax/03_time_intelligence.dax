// ==============================================================================
// DAX MEASURES: Time Intelligence (YTD, Prior Year, Growth)
// ==============================================================================
// PREREQUISITE:
// Requires the 'Dim_Date' table created in '00_calendar_date_table.dax'
// with an active relationship between 'Dim_Date'[Date] and 'fact_sales'[OrderDate].
// ==============================================================================

// 1. Year-To-Date (YTD) Revenue
// Cumulative revenue from the start of the calendar year up to the filtered date
Revenue YTD = 
TOTALYTD(
    [Total Revenue],
    Dim_Date[Date]
)


// 2. Prior Year (PY) Revenue
// Revenue for the equivalent period in the previous year
Revenue Prior Year = 
CALCULATE(
    [Total Revenue],
    SAMEPERIODLASTYEAR(Dim_Date[Date])
)


// 3. Year-over-Year (YoY) Revenue Growth ($)
// Absolute dollar change compared to the previous year
YoY Revenue Growth $ = 
[Total Revenue] - [Revenue Prior Year]


// 4. Year-over-Year (YoY) Revenue Growth %
// Percentage growth compared to previous year (Format as Percentage, 1 decimal)
YoY Revenue Growth % = 
DIVIDE(
    [YoY Revenue Growth $],
    [Revenue Prior Year],
    BLANK()
)


// 5. Month-To-Date (MTD) Revenue
// Cumulative revenue from the start of the current month
Revenue MTD = 
TOTALMTD(
    [Total Revenue],
    Dim_Date[Date]
)


// 6. Previous Month (PM) Revenue
// Revenue for the previous month
Revenue Previous Month = 
CALCULATE(
    [Total Revenue],
    DATEADD(Dim_Date[Date], -1, MONTH)
)


// 7. Month-over-Month (MoM) Revenue Growth %
MoM Revenue Growth % = 
VAR PreviousMonthRevenue = [Revenue Previous Month]
RETURN
    DIVIDE(
        [Total Revenue] - PreviousMonthRevenue,
        PreviousMonthRevenue,
        BLANK()
    )
